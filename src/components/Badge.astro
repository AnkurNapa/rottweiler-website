---
// The paw badge from the Rottweiler letterhead, defined once as a symbol and reused with <use href="#badge">.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="badge" viewBox="0 0 120 120">
    <circle cx="60" cy="60" r="58" fill="#0a0a0a" stroke="#ffffff" stroke-width="3.4"/>
    <svg x="13" y="18" width="94" height="84" viewBox="-6 0 112 100">
      <g fill="#ffffff">
        <ellipse cx="50" cy="72" rx="24.5" ry="18"/><ellipse cx="50" cy="61" rx="17" ry="12.5"/>
        <circle cx="31" cy="79" r="11.5"/><circle cx="50" cy="82" r="12"/><circle cx="69" cy="79" r="11.5"/>
        <ellipse cx="34" cy="28" rx="11" ry="14.5" transform="rotate(-12 34 28)"/><ellipse cx="66" cy="28" rx="11" ry="14.5" transform="rotate(12 66 28)"/>
        <ellipse cx="12" cy="45" rx="10.5" ry="14" transform="rotate(-38 12 45)"/><ellipse cx="88" cy="45" rx="10.5" ry="14" transform="rotate(38 88 45)"/>
        <ellipse cx="30" cy="8" rx="3.4" ry="5.4" transform="rotate(-18 30 8)"/><ellipse cx="70" cy="8" rx="3.4" ry="5.4" transform="rotate(18 70 8)"/>
        <ellipse cx="2.5" cy="28" rx="3.2" ry="5.2" transform="rotate(-48 2.5 28)"/><ellipse cx="97.5" cy="28" rx="3.2" ry="5.2" transform="rotate(48 97.5 28)"/>
      </g>
      <g fill="#0a0a0a"><circle cx="35" cy="94" r="8"/><circle cx="65" cy="94" r="8"/></g>
    </svg>
  </symbol>
</svg>
