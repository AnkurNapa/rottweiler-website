---
import beers from '../data/beers.json';
import { asset, contact } from '../data/site.js';
const home = asset('');
---
<footer>
  <div class="wrap">
    <div class="grid">
      <div>
        <a class="lockup" href={home}><svg aria-hidden="true"><use href="#badge"/></svg><span><b>ROTTWEILER</b><small>Brew and Pub</small></span></a>
        <p class="tag">Four beers with the heart of a Rottweiler. One written standard for every batch.</p>
      </div>
      <div>
        <h4>The beers</h4>
        <ul>{beers.map((b) => <li><a href={asset(`beers/${b.slug}/`)}>Rottweiler {b.name}</a></li>)}</ul>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href={`${home}#story`}>Our story</a></li>
          <li><a href={`${home}#finder`}>Pick your dog</a></li>
          <li><a href={`${home}#guard`}>For those who serve</a></li>
          <li><a href={asset('blog/')}>Journal</a></li>
          <li><a href={`${home}#trade`}>Trade</a></li>
          <li><a href={asset('privacy/')}>Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="big" aria-hidden="true">ROTTWEILER</div>
    <div class="legal">
      <span><strong>{contact.legalName}</strong> · CIN {contact.cin}</span>
      <span>Drink responsibly. For adults of legal drinking age only. Do not drink and drive.</span>
    </div>
  </div>
</footer>
