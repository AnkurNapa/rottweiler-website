---
import { asset } from '../data/site.js';
---
<section class="sec founder" id="founder" aria-labelledby="founder-h">
  <div class="wrap">
    <figure><img src={asset('img/founder.jpg')} alt="Ankur Napa, founder of Rottweiler Brew and Pub" width="900" height="962" loading="lazy"></figure>
    <div>
      <div class="eyebrow">Meet the founder</div>
      <h2 id="founder-h">From the brew floor to Rottweiler.</h2>
      <p>I learnt brewing science in Pune and spent more than eight years as an R&amp;D master brewer at AB InBev in India. Then I moved into data, building platforms for beer, whisky and wine producers.</p>
      <p>Rottweiler is what both worlds taught me, in one glass.</p>
      <p class="sign">Ankur Napa, Founder</p>
      <a class="pill" href={asset('founder/')}>Read my story</a>
    </div>
  </div>
</section>
