---
import { gaId, asset } from '../data/site.js';
// Google Analytics 4 with consent first: nothing loads until the visitor taps Allow.
// The choice is remembered in this browser. Set gaId in src/data/site.js to switch it on.
---
{gaId && (
  <>
    <div class="consent" id="consent" role="region" aria-label="Analytics choice" hidden>
      <p>We use Google Analytics to see which pages help people find our beer. Nothing is tracked unless you allow it. <a href={asset('privacy/')}>Privacy notice</a></p>
      <div class="consent-btns">
        <button type="button" class="pill" id="consent-yes">Allow</button>
        <button type="button" class="link" id="consent-no">No thanks</button>
      </div>
    </div>
    <script is:inline define:vars={{ gaId }}>
      (function () {
        var KEY = 'rw-analytics';
        var box = document.getElementById('consent');
        var choice = null;
        try { choice = localStorage.getItem(KEY); } catch (e) {}
        function load() {
          if (window.gtag) return;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} box.hidden = true; if (v === 'yes') load(); }
        if (choice === 'yes') load();
        else if (choice !== 'no') box.hidden = false;
        document.getElementById('consent-yes').addEventListener('click', function () { save('yes'); });
        document.getElementById('consent-no').addEventListener('click', function () { save('no'); });
        // Key actions become events: joins, pour alerts, trade enquiries, shares and quiz results.
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a, button');
          if (!a || !window.gtag) return;
          var h = a.getAttribute('href') || '';
          if (h.indexOf('wa.me') > -1) gtag('event', 'whatsapp_click', { label: a.textContent.trim() });
          else if (h.indexOf('/beers/') > -1) gtag('event', 'beer_page_click', { label: a.textContent.trim() });
          else if (a.classList.contains('share')) gtag('event', 'share_dog');
        });
        document.addEventListener('rw:quiz', function (e) { if (window.gtag) gtag('event', 'quiz_result', { beer: e.detail }); });
      })();
    </script>
  </>
)}
