---
import Base from '../layouts/Base.astro';
import AgeGate from '../components/AgeGate.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Finder from '../components/Finder.astro';
import Pack from '../components/Pack.astro';
import TasteMap from '../components/TasteMap.astro';
import Guard from '../components/Guard.astro';
import FindUs from '../components/FindUs.astro';
import Trade from '../components/Trade.astro';
import Footer from '../components/Footer.astro';
import Founder from '../components/Founder.astro';
---
<Base>
  <AgeGate />
  <Nav />
  <main id="top">
    <Hero />
    <Story />
    <Founder />
    <Finder />
    <Pack />
    <TasteMap />
    <Guard />
    <FindUs />
    <Trade />
  </main>
  <Footer />
</Base>
